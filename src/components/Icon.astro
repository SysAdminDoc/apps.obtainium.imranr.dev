---
interface Props {
  src?: string;
  alt: string;
  width?: number;
  height?: number;
  className?: string;
  style?: string;
}
const { src, alt, width = 64, height = 64, className = "", style = "" } = Astro.props;
const initials = alt.trim().split(/\s+/).slice(0, 2).map((part: string) => part.charAt(0)).join("").toUpperCase() || "?";
const safeSource = src && /^https?:\/\//i.test(src) ? src : undefined;
---
<span class={"app-icon " + className} style={"width:" + width + "px;height:" + height + "px;min-width:" + width + "px;" + style} aria-hidden="true">
  {safeSource && <img src={safeSource} alt="" width={width} height={height} loading="lazy" referrerpolicy="no-referrer" onerror="this.setAttribute('hidden','');this.nextElementSibling.removeAttribute('hidden')" />}
  <span class="icon-initials" hidden={Boolean(safeSource)}>{initials}</span>
</span>
