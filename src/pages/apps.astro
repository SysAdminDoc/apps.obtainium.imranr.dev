---
import Layout from "../layouts/Layout.astro";
import AppCard from "../components/AppCard.astro";
import FilterForm from "../components/FilterForm.astro";
import Pagination from "../components/Pagination.astro";
import {
  queryAppsAsync,
  extractAppParamsFromRequest,
} from "../lib/query";
import { getApps } from "../lib/data";
import { getInstallCounts, getAppInstallCount } from "../lib/stats";
import {
  getCurrentLanguage,
  getLocalizedStrings,
  localHref,
} from "../lib/i18n";

Astro.response.headers.set('Cache-Control', 'public, max-age=300, s-maxage=600');
Astro.response.headers.set('Vary', 'Accept-Language');

const currentLanguage = await getCurrentLanguage(Astro.url, Astro.request);
const translations = getLocalizedStrings(currentLanguage);

const allApps = getApps();
const allCategories = [
  ...new Set(allApps.flatMap((app) => app.categories)),
].sort();

const { categories, categoryMode, type, q, page, limit, sort } =
  await extractAppParamsFromRequest(Astro.request);

let result;
let errorMessage = "";
try {
  result = await queryAppsAsync({
    categories,
    categoryMode,
    type,
    q,
    page,
    limit,
    sort,
  });
} catch (e) {
  console.error("Catalog request failed", e);
  Astro.response.status = 500;
  Astro.response.headers.set("Cache-Control", "no-store");
  errorMessage = "An error occurred while loading apps. Please try again.";
  result = { apps: [], pagination: { page: 1, limit: 50, total: 0, totalPages: 1 } };
}

const installCounts = await getInstallCounts();
const letterHref = (pageNumber: number) => {
  const params = new URLSearchParams(Astro.url.searchParams);
  params.set("sort", "name");
  params.set("page", String(pageNumber));
  params.set("lang", currentLanguage);
  return "/apps?" + params;
};

let categoryFilterMessage = categories.map((c) => translations[c]).join(", ");
const fullCategoryMessage = categoryFilterMessage;
if (categoryFilterMessage.length > 50) {
  categoryFilterMessage = `${categoryFilterMessage.slice(0, 50)}...`;
}
---

<Layout>
  <div class="container mx-auto px-4 py-6">
    <div class="section-heading"><div><h1 class="text-2xl font-semibold">{translations.browseConfigurations}</h1><p>{translations.reviewSourceNote}</p></div></div>
    <FilterForm
      translations={translations}
      currentLanguage={currentLanguage}
      type={type}
      limit={limit}
      allCategories={allCategories}
      categories={categories}
      categoryMode={categoryMode}
      q={q}
      sort={sort}
    />

    <!-- Results header -->
    <div class="mb-6 px-4 py-3 bg-surface border border-border rounded-2xl flex items-center justify-between gap-2">
      <p class="text-text-muted text-sm">
        <span class="font-medium text-text">{result.apps.length + " / " + result.pagination.total}</span>
        <span style="margin-inline-start: 0.35em">{translations["apps"] || "apps"}</span>
        {categories.length > 0 && ` • `}
        {categories.length > 0 && (
          <span title={fullCategoryMessage} class="text-brand">{categoryFilterMessage}</span>
        )}
        {q && ` • `}
        {q && <span class="text-brand">"{q}"</span>}
      </p>
      {(categories.length > 0 || q) && (
        <a href={localHref("/apps", currentLanguage)} class="text-xs text-text-muted hover:text-primary-500 transition-colors whitespace-nowrap shrink-0">
          {translations["clearFilters"] || "Clear filters"} &times;
        </a>
      )}
    </div>

    {
      errorMessage && (
        <div class="mb-6 p-4 bg-red-900/20 border border-red-800/40 rounded-xl">
          <p class="text-red-400 text-sm">{errorMessage}</p>
        </div>
      )
    }

    {
      !errorMessage && sort === "name" && !q && Object.keys(result.letterPages || {}).length > 0 && (
        <nav class="mb-6 px-4 py-3 bg-surface border border-border rounded-2xl flex flex-wrap gap-1.5" aria-label="Jump to letter">
          {Object.entries(result.letterPages || {}).map(([letter, letterPage]) => (
            <a
              href={letterHref(letterPage)}
              class={`w-8 h-8 inline-flex items-center justify-center rounded-lg text-sm font-medium transition-colors ${
                letterPage === result.pagination.page
                  ? "bg-primary-600 text-on-primary"
                  : "bg-surface-hover text-text-muted hover:text-primary-500"
              }`}
            >
              {letter}
            </a>
          ))}
        </nav>
      )
    }

    <!-- App grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-2 2xl:grid-cols-3 gap-4">
      {
        result.apps.length === 0 && !errorMessage ? (
          <div class="col-span-full flex flex-col items-center justify-center py-16 text-center">
            <div class="w-14 h-14 bg-surface-hover rounded-2xl flex items-center justify-center mb-4">
              <svg class="w-6 h-6 text-text-subtle" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" />
              </svg>
            </div>
            <h3 class="text-base font-semibold text-text-secondary mb-1">
              {translations["noAppsFound"] || "No apps found"}
            </h3>
            <p class="text-text-subtle text-sm max-w-md">
              {q
                ? (translations["noAppsFoundSearch"] || "Try adjusting your search query or filters.")
                : (translations["noAppsFoundFilters"] || "Try selecting different categories or clearing filters.")}
            </p>
          </div>
        ) : (
          result.apps.map((app) => (
            <AppCard
              app={app}
              translations={translations}
              currentLanguage={currentLanguage}
              hideCategories={categories.length === 1}
              installCount={getAppInstallCount(app, installCounts)}
            />
          ))
        )
      }
    </div>

    {
      !errorMessage && (
        <Pagination
          page={result.pagination.page}
          totalPages={result.pagination.totalPages}
          categories={categories}
          url={Astro.url}
        />
      )
    }
  </div>
</Layout>
