---
import Layout from "../layouts/Layout.astro";
import AppCard from "../components/AppCard.astro";
import { getCurrentLanguage, getLocalizedStrings, localHref } from "../lib/i18n";
import { getApps } from "../lib/data";
import { getAppConfig } from "../lib/query";
import { getInstallCounts, getAppInstallCount } from "../lib/stats";

Astro.response.headers.set("Cache-Control", "public, max-age=600, s-maxage=1800");
Astro.response.headers.set("Vary", "Accept-Language");
const currentLanguage = await getCurrentLanguage(Astro.url, Astro.request);
const translations = getLocalizedStrings(currentLanguage);
const allApps = getApps();
const categoryCounts = new Map<string, number>();
for (const app of allApps) for (const category of app.categories) categoryCounts.set(category, (categoryCounts.get(category) || 0) + 1);
const categories = [...categoryCounts.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
const examples = ["LocalSend", "CoMaps", "keepass2android", "Read You"].map(name => allApps.find(app => getAppConfig(app).some(config => config.name === name))).filter((app): app is (typeof allApps)[number] => Boolean(app));
const installCounts = await getInstallCounts();
const popularApps = allApps.filter(app => getAppInstallCount(app, installCounts) > 0).sort((a, b) => getAppInstallCount(b, installCounts) - getAppInstallCount(a, installCounts)).slice(0, 4);
---
<Layout>
  <div class="container mx-auto px-5 py-8">
    <section class="catalog-hero">
      <div class="hero-copy">
        <p class="eyebrow">{translations.communityCatalog}</p>
        <h1>{translations.heroTitle}</h1>
        <p class="hero-description">{translations.catalogDescription}</p>
        <form action="/apps" method="get" role="search" class="hero-search">
          <input type="hidden" name="lang" value={currentLanguage} />
          <label class="sr-only" for="home-search">{translations.searchText}</label>
          <input id="home-search" name="q" type="search" placeholder={translations.searchText} />
          <button type="submit">{translations.searchButton}</button>
        </form>
        <a class="text-link" href={localHref("/apps", currentLanguage)}>{translations.browseAllApps} <span aria-hidden="true">↗</span></a>
      </div>
      <aside class="catalog-facts">
        <p class="eyebrow">{translations.inThisSnapshot}</p>
        <div class="catalog-total"><strong>{allApps.length}</strong><span>{translations.appListings}</span></div>
        <p class="catalog-category-total">{categories.length} {translations.categories.toLowerCase()}</p>
        <div class="facts-note"><strong>{translations.configsNotApks}</strong><p>{translations.importNote}</p></div>
      </aside>
    </section>
    <section class="catalog-section" aria-labelledby="category-heading">
      <div class="section-heading"><h2 id="category-heading">{translations.browseByCategory}</h2><a class="text-link" href={localHref("/apps", currentLanguage)}>{translations.viewAll} <span aria-hidden="true">↗</span></a></div>
      <div class="category-grid">
        {categories.slice(0, 12).map(([category, count]) => <a class="category-tile" href={localHref("/apps?category=" + encodeURIComponent(category), currentLanguage)}><span>{translations[category] || category}</span><strong>{count}</strong></a>)}
      </div>
    </section>
    <section class="catalog-section" aria-labelledby="example-heading">
      <div class="section-heading"><div><h2 id="example-heading">{translations.fromTheCatalog}</h2><p>{translations.reviewSourceNote}</p></div></div>
      <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-4">{examples.map(app => <AppCard app={app} translations={translations} currentLanguage={currentLanguage} />)}</div>
    </section>
    {popularApps.length > 0 && <section class="catalog-section" aria-labelledby="popular-heading"><div class="section-heading"><h2 id="popular-heading">{translations.popularLinkClicks}</h2></div><div class="grid grid-cols-1 md:grid-cols-2 gap-4">{popularApps.map(app => <AppCard app={app} translations={translations} currentLanguage={currentLanguage} installCount={getAppInstallCount(app, installCounts)} />)}</div></section>}
    <section class="catalog-help">
      <h2>{translations.newToObtainium}</h2><p>{translations.obtainiumHelp}</p>
      <a class="text-link" href="https://obtainium.imranr.dev/">{translations.getObtainium} <span aria-hidden="true">↗</span></a>
    </section>
  </div>
</Layout>
