---
import Layout from "../layouts/Layout.astro";
import { getCurrentLanguage, getLocalizedStrings, localHref } from "../lib/i18n";
import { parseRedirect } from "../lib/config";
Astro.response.headers.set("Cache-Control", "no-store");
const currentLanguage = await getCurrentLanguage(Astro.url, Astro.request);
const translations = getLocalizedStrings(currentLanguage);
const result = parseRedirect(Astro.url.searchParams.get("r"));
if ("error" in result && Astro.url.searchParams.has("r")) Astro.response.status = 400;
---
<Layout title={translations.reviewConfiguration}>
  <div class="container mx-auto px-5 py-10">
    <section class="redirect-card">
      <p class="eyebrow">OBTAINIUM</p>
      {"error" in result ? <>
        <h1>{translations.reviewConfiguration}</h1>
        <p class="redirect-error" role="status">{translations[result.error] || translations.invalidUrl}</p>
        <p>{translations.missingRedirectHelp}</p>
      </> : <>
        <p class="ready-label">{translations.configurationReady}</p>
        <h1>{result.name}</h1>
        <p>{translations.reviewBeforeImport}</p>
        <div class="redirect-source"><span>{translations.sourceUrl}</span><a href={result.source} target="_blank" rel="noopener noreferrer">{result.source}</a></div>
        <a class="primary-action" id="redirectBtn" href={result.href}>{translations.addToObtainium}</a>
        <p class="redirect-note">{translations.redirectHelp}</p>
      </>}
      <div class="redirect-links"><a href="https://obtainium.imranr.dev/">{translations.getObtainium}</a><a href={localHref("/apps", currentLanguage)}>{translations.browseApps}</a></div>
    </section>
  </div>
</Layout>
