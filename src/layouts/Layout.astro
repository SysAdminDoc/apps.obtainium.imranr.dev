---
import { getCurrentLanguage, getLocalizedStrings, localHref } from "../lib/i18n";
import { version } from "../../package.json";
import "../styles/global.css";

const { title } = Astro.props;
const currentLanguage = await getCurrentLanguage(Astro.url, Astro.request);
const translations = getLocalizedStrings(currentLanguage);
const siteTitle = (title ? title + " | " : "") + translations.title + " | SysAdminDoc fork";
const siteDescription = translations.catalogDescription;
const canonical = new URL(Astro.url.pathname, Astro.url.origin);
if (Astro.url.searchParams.has("lang")) canonical.searchParams.set("lang", currentLanguage);
---
<!doctype html>
<html class="h-full" lang={currentLanguage} dir={["fa", "ar", "he"].includes(currentLanguage) ? "rtl" : "ltr"} data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{siteTitle}</title>
    <meta name="description" content={siteDescription} />
    <meta name="theme-color" content="#10131c" />
    <meta name="referrer" content="no-referrer" />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={siteDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL("/social-card.png", Astro.url.origin)} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.png" />
    {Astro.url.pathname === "/redirect" && <meta name="robots" content="noindex, nofollow" />}
    <script is:inline>
      try { document.documentElement.dataset.theme = localStorage.getItem("catalog-theme") === "light" ? "light" : "dark"; } catch {}
    </script>
    <noscript><style>.jsonly, .app-icon img { display: none !important; } .app-icon .icon-initials[hidden] { display: flex !important; }</style></noscript>
  </head>
  <body class="text-text min-h-screen flex flex-col">
    <a href="#main-content" class="skip-link">{translations.skipContent}</a>
    <header class="site-header">
      <div class="container mx-auto px-5 py-4 header-inner">
        <a href={localHref("/", currentLanguage)} class="site-brand">
          <img src="/favicon.png" width="34" height="34" alt="" />
          <span><strong>{translations.title}</strong><small>SysAdminDoc fork</small></span>
        </a>
        <nav class="site-nav" aria-label={translations.mainNavigation}>
          <a href={localHref("/apps", currentLanguage)}>{translations.browseApps}</a>
          <a href="https://wiki.obtainium.imranr.dev/" rel="noopener noreferrer">{translations.about}</a>
          <a href="https://github.com/SysAdminDoc/apps.obtainium.imranr.dev" rel="noopener noreferrer">{translations.source}</a>
          <button class="theme-button jsonly" type="button" data-theme-toggle data-light={translations.lightTheme} data-dark={translations.darkTheme}>{translations.lightTheme}</button>
        </nav>
      </div>
    </header>
    <main id="main-content" class="grow"><slot /></main>
    <footer class="site-footer">
      <div class="container mx-auto px-5 footer-inner">
        <p>Obtainium Apps v{version}<br /><span>{translations.forkNotice}</span></p>
        <div>
          <a href="https://github.com/ImranR98/apps.obtainium.imranr.dev">{translations.upstreamSource}</a>
          <a href="https://apps.obtainium.imranr.dev/">{translations.officialCatalog}</a>
          <a href="https://github.com/SysAdminDoc/apps.obtainium.imranr.dev/blob/main/LICENSE">GPL-3.0</a>
        </div>
      </div>
    </footer>
    <div id="copy-status" role="status" aria-live="polite" class="copy-status" hidden data-success={translations.copiedConfig} data-failure={translations.copyFailed}></div>
    <script is:inline>
      (() => {
        const toggle = document.querySelector("[data-theme-toggle]");
        const sync = () => { if (toggle) toggle.textContent = document.documentElement.dataset.theme === "light" ? toggle.dataset.dark : toggle.dataset.light; };
        sync();
        toggle?.addEventListener("click", () => {
          const theme = document.documentElement.dataset.theme === "light" ? "dark" : "light";
          document.documentElement.dataset.theme = theme;
          try { localStorage.setItem("catalog-theme", theme); } catch {}
          sync();
        });
        let timer;
        window.copyToClipboard = async (text) => {
          const status = document.getElementById("copy-status");
          if (!status) return;
          clearTimeout(timer);
          try {
            if (!navigator.clipboard?.writeText) throw new Error("Clipboard is unavailable");
            await navigator.clipboard.writeText(text);
            status.textContent = status.dataset.success;
            status.dataset.error = "false";
          } catch {
            status.textContent = status.dataset.failure;
            status.dataset.error = "true";
          }
          status.hidden = false;
          timer = setTimeout(() => { status.hidden = true; }, 6500);
        };
      })();
    </script>
  </body>
</html>
