{
  "name": "apps-obtainium-imranr-dev",
  "type": "module",
  "version": "0.0.3",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "astro dev",
    "build": "npm run validate && node scripts/clean-build.mjs && astro build",
    "start": "node scripts/start.mjs",
    "preview": "astro preview",
    "typecheck": "astro check",
    "validate": "node --import tsx scripts/validate-data.ts",
    "validate:icons": "node scripts/validate_icons.js --dry-run",
    "test": "node --import tsx --test tests/*.test.ts",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/node": "11.1.5",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.3.2",
    "sharp": "0.35.4",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.0",
    "@types/node": "^25.0.10",
    "@types/node-fetch": "^2.6.13",
    "node-fetch": "^3.3.2",
    "typescript": "^5.7.0",
    "tsx": "4.23.13"
  }
}
